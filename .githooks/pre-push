#!/usr/bin/env bash
#
# pre-push: refuse a push whose commits break the message rules of CLAUDE.md (Commits), checked by
# tools/commit_lint.zig. Install it once per clone with `zig build hooks`, which points this
# clone's core.hooksPath at .githooks.
#
# git runs this hook with the remote name as $1 and its URL as $2, and writes one line per ref
# being pushed on standard input:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# For each line the hook lints one set of revision arguments:
#   - a local sha of all zeros deletes the remote ref and pushes no commit, so the line is skipped;
#   - a remote sha of all zeros means the branch is new on the remote, so the hook lints
#     `<local sha> --not --remotes`, the commits reachable from the branch and from no
#     remote-tracking ref, which is exactly what the push adds to the remote;
#   - otherwise it lints <remote sha>..<local sha>, the commits the push adds.
#
# `--not --remotes` needs no refs/remotes/<remote>/HEAD and no guess at how many commits are new,
# so a fresh clone whose history predates these rules does not have that history linted on its
# first branch push.
#
# The linter exits 1 for a rule that was violated and 2 when it could not run. The hook refuses the
# push on either, and says which happened. It exits 0 for a message that only drew warnings, whose
# lines the hook still prints: a scope outside the module graph is reported and never refused.
#
# The hook reads only local git objects and runs one linter that compiles one file: no network call
# and no build of the tree.

set -euo pipefail

# The sha git writes for a ref that does not exist yet or is being deleted.
readonly absent_sha_pattern='^0+$'
# The linter, preferred as the installed binary and run from source when that binary has not been
# built.
readonly compiled_linter="zig-out/bin/commit_lint"
readonly linter_source="tools/commit_lint.zig"
# The exit status the linter reports when it ran and found a rule violated. Any other non-zero
# status is the linter itself failing.
readonly linter_found_violations=1

cd "$(git rev-parse --show-toplevel)"

if [[ ! -x "$compiled_linter" ]] && ! command -v zig >/dev/null 2>&1; then
  echo "pre-push: no $compiled_linter and no zig on PATH, so commit messages cannot be linted" >&2
  exit 1
fi

# Prints the git revision arguments to lint for one pushed ref, one per line.
revisions_for() {
  local local_sha="$1"
  local remote_sha="$2"

  if [[ "$remote_sha" =~ $absent_sha_pattern ]]; then
    printf '%s\n--not\n--remotes\n' "$local_sha"
    return 0
  fi
  printf '%s..%s\n' "$remote_sha" "$local_sha"
}

# Runs the linter over the revision arguments it is given, printing one line per finding and
# exiting with the linter's own status. Standard input is closed, so nothing the linter runs eats
# the ref lines the loop below reads.
run_linter() {
  if [[ -x "$compiled_linter" ]]; then
    "$compiled_linter" --range "$@" </dev/null
  else
    zig run "$linter_source" -- --range "$@" </dev/null
  fi
}

status=0
# Set when a message actually broke a rule, which is the only case a rebase fixes. A linter that
# failed to run says so on its own line instead.
found_violations=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" =~ $absent_sha_pattern ]]; then
    continue
  fi
  # revisions_for prints one argument per line, so the loop rebuilds them as an array and the
  # linter receives them as separate arguments.
  revisions=()
  while IFS= read -r revision; do
    revisions+=("$revision")
  done < <(revisions_for "$local_sha" "$remote_sha")

  linter_status=0
  findings="$(run_linter "${revisions[@]}")" || linter_status=$?

  if [[ "$linter_status" -eq 0 ]]; then
    # Warnings only. They are printed and the push goes on.
    if [[ -n "$findings" ]]; then
      printf '%s\n' "$findings" >&2
    fi
    continue
  fi

  status=1
  if [[ "$linter_status" -ne "$linter_found_violations" ]]; then
    echo "pre-push: the commit linter failed on ${revisions[*]} (exit ${linter_status}); the messages were not checked" >&2
    continue
  fi
  found_violations=1
  echo "pre-push: ${local_ref} -> ${remote_ref} (${revisions[*]}) has commit messages that break the rules:" >&2
  if [[ -n "$findings" ]]; then
    printf '%s\n' "$findings" >&2
  fi
done

if [[ "$found_violations" -ne 0 ]]; then
  echo "pre-push: fix the messages with git rebase -i, or push with --no-verify to skip this hook" >&2
fi
exit "$status"
