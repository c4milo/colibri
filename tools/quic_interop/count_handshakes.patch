@@ -309,10 +309,22 @@ class TestCase(abc.ABC):
 
     def _count_handshakes(self) -> int:
         """Count the number of QUIC handshakes"""
-        tr = self._server_trace()
-        # Determine the number of handshakes by looking at Initial packets.
-        # This is easier, since the SCID of Initial packets doesn't changes.
-        return len(set([p.scid for p in tr.get_initial(Direction.FROM_SERVER)]))
+        tr = self._client_trace()
+        # Count the client's connection attempts: the Destination Connection IDs it chose for
+        # its Initial packets. After the server's Initial or Retry, the client sends to the
+        # Source Connection ID the server chose (RFC 9000, Section 7.2), so those are left out.
+        # Counting the server's Initial SCIDs would also count a connection the server dropped
+        # before the client heard from it, and a client's first Initial need not be numbered 0,
+        # because an endpoint may skip packet numbers (RFC 9000, Section 21.4).
+        server_chosen = set(
+            getattr(p, "scid", "")
+            for p in tr.get_initial(Direction.FROM_SERVER)
+            + tr.get_retry(Direction.FROM_SERVER)
+        )
+        client_chosen = set(
+            getattr(p, "dcid", "") for p in tr.get_initial(Direction.FROM_CLIENT)
+        )
+        return len(client_chosen - server_chosen)
 
     def _get_versions(self) -> set:
