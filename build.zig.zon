.{
    .name = .colibri,
    .version = "0.21.0",
    .fingerprint = 0xa648cb8abe808f5a,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library (decision 36). Lazy, and requested
        // only when colibri is the root build, so a project that depends on colibri never fetches it.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#a90cc29dc68130969d7ef5d8d9a79b2867a61614",
            .hash = "pepegrillo-0.0.0-axiFUG91DQDsKhugwKWV7zfEE7Q3kAZE3tJFL5i1p8HJ",
            .lazy = true,
        },
        // The event loop of the `.private` kind of the `colibri` module (decisions 150 and 159),
        // of `src/testing/`'s endpoints (decision 58) and of `examples/` (decision 96). Lazy: a
        // build requests it only with the option `rotor`, whose default is true at colibri's own
        // root and false for a dependent. So a project that uses the protocol modules, or
        // `colibri` with `.hosted`, never fetches it. A project that uses `.private` passes
        // `.rotor = true` to `b.dependency("colibri", ...)`.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#af06860db3c56180557dc7d7e10ab51c58c43094",
            .hash = "rotor-0.11.0-YZkxRGc9JwCI6Lyp1nPvw5o6XKWk8KoXi3ciP7CwKEtW",
            .lazy = true,
        },
        // The QPACK vectors of qpackers/qifs, which tools/qpack_vectors.zig decodes (decisions 25
        // and 75). Test data, never linked into anything. Lazy, and requested only when colibri
        // is the root build, like pepegrillo.
        .qifs = .{
            .url = "https://github.com/qpackers/qifs/archive/da52cd936b3e34dac7ac12aa8066fc57676af106.tar.gz",
            .hash = "N-V-__8AACPGUgeB6kOEJXkaQuKfDvAXxeXYW9wcU6TpfDty",
            .lazy = true,
        },
        // The codecs h11, the server and the client code content with (decisions 90, 91 and 101),
        // the JSON writer of qlog (decision 102), the CPU features (decision 169), and chapulin,
        // the TLS stack and the packet protection, as `stdx.crypto`, whose sessions take the
        // program's `stdx.crypto.Context` (decisions 174 and 175). The library imports it, so it
        // is not lazy: a project that depends on colibri fetches it, and stdx fetches chapulin for
        // it.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#a11db0bfcf5acb176b504e60789fa731c42b0252",
            .hash = "stdx-0.3.0-BD60to9OXQCZwP25ZzE67Ihvtvq1DoksAepvn5CBet3T",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
    },
}
