.{
    .name = .colibri,
    .version = "0.0.0",
    .fingerprint = 0xa648cb8abe808f5a,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library (decision 36). Lazy, and requested
        // only when colibri is the root build, so a project that depends on colibri never fetches it.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#49c9e9c387acfd5b62d7a7ea58b20c084e66c04c",
            .hash = "pepegrillo-0.0.0-axiFUM-kCAC8o5-JAFYJ7bo5nSwL6aKjcxYN7ApI1HK3",
            .lazy = true,
        },
        // The event loop of `src/testing/`'s endpoints, never linked into the library
        // (decision 58). Lazy, and requested only when colibri is the root build, like
        // pepegrillo.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#fbe93112dcdf3b426e8cb7673d23942ff3688c5e",
            .hash = "rotor-0.3.0-YZkxRE3jEADjVwL4zxZdps9TbHyKcuwxWQ5N_W_x1neB",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
    },
}
