.{
    .name = .colibri,
    .version = "0.10.0",
    .fingerprint = 0xa648cb8abe808f5a,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library (decision 36). Lazy, and requested
        // only when colibri is the root build, so a project that depends on colibri never fetches it.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#9ae244b9ab55eb8c7259a656d08db85c9f8c42e8",
            .hash = "pepegrillo-0.0.0-axiFUFeJDACO8UB_GWT7OSbSKD2QOChXCg68MdfzduJq",
            .lazy = true,
        },
        // The event loop of `src/testing/`'s endpoints (decision 58) and of the library's
        // `colibri` module (decision 150). The library imports it, so it is not lazy: a project
        // that depends on colibri fetches it too.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor#5a5d7d72d8ac4469a48b2a30d77380ac9dd7b90e",
            .hash = "rotor-0.9.0-YZkxRHY2FQCOGvEpDOWDofpk-UhPMwgUpaU3GyaBzhda",
        },
        // The QPACK vectors of qpackers/qifs, which tools/qpack_vectors.zig decodes (decisions 25
        // and 75). Test data, never linked into anything. Lazy, and requested only when colibri
        // is the root build, like pepegrillo.
        .qifs = .{
            .url = "https://github.com/qpackers/qifs/archive/da52cd936b3e34dac7ac12aa8066fc57676af106.tar.gz",
            .hash = "N-V-__8AACPGUgeB6kOEJXkaQuKfDvAXxeXYW9wcU6TpfDty",
            .lazy = true,
        },
        // The TLS stack and the packet protection (decision 94), compiled from source with
        // `RAND=session` in each configuration colibri uses (design §8 step 16). The library's
        // `tls` module imports it, so it is not lazy: a project that depends on colibri fetches it
        // too.
        .chapulin = .{
            .url = "git+https://github.com/c4milo/chapulin#15c37ef48ae506fcf3d28607c669b79b2c0c303a",
            .hash = "chapulin-0.5.0-btv9NjbXOACa-_MoM4tobDCH0KCd2Yb1CVyc7Vd1a0eT",
        },
        // The decoders of the gzip and deflate transfer codings h11 reads (decisions 90 and 91,
        // design §8 step 14). The library imports it, so it is not lazy: a project that depends on
        // colibri fetches it too.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#0c0ba959bda1a0e318e9171d4542beae3df262cc",
            .hash = "stdx-0.0.0-BD60tuF5NQByxf5nikkIoKXfpwr6OhHXuSP71hE5v0Ux",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
    },
}
